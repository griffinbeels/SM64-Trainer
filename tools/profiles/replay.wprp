<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="SM64 Trainer">
 <Profiles>
  <SystemCollector Id="Kernel" Name="SM64 bounded kernel">
   <BufferSize Value="256"/><Buffers Value="256"/>
  </SystemCollector>
  <EventCollector Id="Graphics" Name="SM64 bounded graphics">
   <BufferSize Value="256"/><Buffers Value="256"/>
  </EventCollector>
  <SystemProvider Id="KernelProvider">
   <Keywords>
    <Keyword Value="CpuConfig"/><Keyword Value="ProcessThread"/><Keyword Value="Loader"/>
    <Keyword Value="SampledProfile"/><Keyword Value="CSwitch"/><Keyword Value="ReadyThread"/>
    <Keyword Value="DPC"/><Keyword Value="Interrupt"/>
   </Keywords>
   <Stacks><Stack Value="SampledProfile"/></Stacks>
  </SystemProvider>
  <EventProvider Id="Dxg" Name="Microsoft-Windows-DxgKrnl" Level="5">
   <Keywords><Keyword Value="0x277"/></Keywords>
   <CaptureStateOnStart><Keyword Value="0x277"/></CaptureStateOnStart>
  </EventProvider>
  <Profile Id="Replay.Light.Memory" Name="Replay" Description="Bounded CPU and graphics scheduling" LoggingMode="Memory" DetailLevel="Light">
   <Collectors>
    <SystemCollectorId Value="Kernel"><SystemProviderId Value="KernelProvider"/></SystemCollectorId>
    <EventCollectorId Value="Graphics"><EventProviders><EventProviderId Value="Dxg"/></EventProviders></EventCollectorId>
   </Collectors>
  </Profile>
 </Profiles>
</WindowsPerformanceRecorder>
